{
  "manifest_version": 3,
  "name": "LLM URL Prompt",
  "version": "2.0",
  "description": "Open any supported AI chat with ?prompt=<text> to fill the composer. Add &send to submit automatically.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://meta.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://www.kimi.ai/*",
        "https://manus.im/*",
        "https://poe.com/*",
        "https://chat.z.ai/*",
        "https://pi.ai/*",
        "https://duck.ai/*",
        "https://venice.ai/*",
        "https://openrouter.ai/*",
        "https://t3.chat/*",
        "https://www.genspark.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
