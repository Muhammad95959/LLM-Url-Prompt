{
  "manifest_version": 3,
  "name": "LLM URL Prompt",
  "version": "1.0.0",
  "description": "Fill (and optionally send) prompts in ChatGPT, Gemini, Claude and DeepSeek straight from URL parameters.",
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://platform.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://platform.deepseek.com/*"
      ],
      "js": ["src/sites.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "LLM URL Prompt"
  }
}